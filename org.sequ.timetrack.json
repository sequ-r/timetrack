{
    "id": "org.sequ.timetrack",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "timetrack",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.sequ.timetrack",
        "--filesystem=xdg-run/timetrack"
    ],
    "build-options": {
        "build-args": [
            "--share=network"
        ],
        "env": {
            "CARGO_HOME": "/run/build/timetrack/cargo-home",
            "RUSTUP_HOME": "/run/build/timetrack/rustup-home",
            "RUST_BACKTRACE": "1"
        }
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "timetrack",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/sequ-r/timetrack.git",
                    "branch": "main"
                }
            ],
            "build-commands": [
                "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o rustup-init.sh",
                "sh rustup-init.sh -y --default-toolchain 1.98.0 --profile minimal --no-modify-path",
                "export PATH=\"$RUSTUP_HOME/toolchains/1.98.0-x86_64-unknown-linux-gnu/bin:$PATH\" && cargo build --release --locked --package timetrack-gui --package timetrack-service",
                "install -Dm0755 target/release/timetrack-gui /app/bin/timetrack",
                "install -Dm0755 target/release/timetrack-service /app/bin/timetrack-service",
                "install -Dm0644 data/org.sequ.timetrack.service.in /app/share/dbus-1/services/org.sequ.timetrack.service",
                "install -Dm0644 data/org.sequ.timetrack.desktop /app/share/applications/org.sequ.timetrack.desktop",
                "install -Dm0644 data/org.sequ.timetrack.metainfo.xml /app/share/metainfo/org.sequ.timetrack.metainfo.xml",
                "install -Dm0644 data/icons/hicolor/scalable/apps/org.sequ.timetrack.svg /app/share/icons/hicolor/scalable/apps/org.sequ.timetrack.svg",
                "install -Dm0644 data/icons/hicolor/symbolic/apps/org.sequ.timetrack-symbolic.svg /app/share/icons/hicolor/symbolic/apps/org.sequ.timetrack-symbolic.svg"
            ]
        }
    ]
}
