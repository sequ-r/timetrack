<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.sequ.timetrack</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Timetrack</name>
  <summary>Track time on your desktop activities</summary>
  <description>
    <p>
      Timetrack is a time tracking application for the GNOME desktop. It lets
      you record what you work on and review how your time is spent.
    </p>
    <p>
      Its interface follows the GNOME design guidelines and integrates with
      the standard desktop settings, notifications and session management.
    </p>
  </description>

  <developer id="tld.vendor">
    <name>Sebastiano Quintini</name>
  </developer>

  <url type="homepage">https://github.com/sequ-r/timetrack</url>
  <url type="vcs-browser">https://github.com/sequ-r/timetrack</url>
  <url type="bugtracker">https://github.com/sequ-r/timetrack/issues</url>
  <url type="translate">https://github.com/sequ-r/timetrack</url>
  <url type="contribute">https://github.com/sequ-r/timetrack</url>

  <translation type="gettext">timetrack</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">org.sequ.timetrack.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-09-28">
      <description>
        <p>Initial development release.</p>
      </description>
    </release>
  </releases>

</component>
