# Rust / Cargo
/target/
**/*.rs.bk

# Meson
/build/
/builddir/
/.flatpak-builder/

# NOTE: src/config.rs is generated by meson from src/config.rs.in, but it is
# deliberately tracked. Cargo cannot build without it, so a fresh clone would
# fail with "file not found for module `config`" on a plain `cargo build`.
# Meson regenerates and overwrites it on every build.

# Editor / OS
*.swp
*~
.DS_Store
